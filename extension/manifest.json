{
  "manifest_version": 3,
  "name": "Kartaan Auto-sync",
  "version": "0.1.18",
  "minimum_chrome_version": "111",
  "key": "",
  "description": "Fetches a seller's own reports from Meesho and Flipkart, in their own browser.",
  "action": {
    "default_title": "Kartaan Auto-sync",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "downloads",
    "scripting",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://supplier.meesho.com/*",
    "https://seller.flipkart.com/*",
    "https://sellercentral.amazon.in/*",
    "https://storage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://api.kartaan.com/*",
    "https://raw.githubusercontent.com/kartaan-com/Kartaan-AutoSync/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://erp.kartaan.com/*"
    ]
  },
  "oauth2": {
    "client_id": "668375542231-8pr119f04gfe545h7jf2knuf8fl17spt.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.flipkart.com/*"
      ],
      "js": [
        "catch-early.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://supplier.meesho.com/*",
        "https://seller.flipkart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "driver.js",
        "walk.js",
        "ads.js",
        "keywords.js",
        "tables.js",
        "recipes.json"
      ],
      "matches": [
        "https://supplier.meesho.com/*",
        "https://seller.flipkart.com/*"
      ]
    }
  ]
}
